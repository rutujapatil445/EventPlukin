            android:name=".registration"
            android:exported="false" />
        <activity
            android:name=".business"
            android:exported="false" />
        <activity
            android:name=".Reception"
            android:exported="false" />
        <activity
            android:name=".Wedding"
            android:exported="false" />
        <activity
            android:name=".Engagement"
            android:exported="false" />
        <activity
            android:name=".birthday"
            android:exported="false" />
        <activity
            android:name=".Login"
            android:exported="false" />
        <activity
            android:name=".BottomNav"
            android:exported="false">

            <!-- Add any intent filters if needed -->
        </activity>
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service android:name=".MyService" android:enabled="true">
        </service>

    </application>

</manifest>