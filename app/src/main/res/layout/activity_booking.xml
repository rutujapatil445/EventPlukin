<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/h4"
    tools:context=".Booking">

    <TextView
        android:layout_width="270dp"
        android:layout_height="90dp"
        android:text="Your Booking Done Successfully"
        android:textColor="#FF9100"
        android:layout_below="@id/b"
        android:layout_marginLeft="70dp"
        android:layout_marginTop="80dp"
        android:paddingTop="13dp"
        android:textStyle="bold"
        android:textSize="30dp"
        android:drawableLeft="@drawable/book"
        />

    <TextView
        android:layout_width="270dp"
        android:layout_height="120dp"
        android:text="Advance Payment Through below QR code Remaning payment is collected after event.."
        android:layout_below="@id/b"
        android:layout_marginLeft="30dp"
        android:layout_marginTop="50dp"
        android:paddingTop="13dp"
        android:textStyle="bold"
        android:textSize="20dp"
        android:textColor="#3C2470"
        />

    <TextView
        android:layout_width="270dp"
        android:layout_height="80dp"
        android:text="After your booking will confirm we will contact with you"
        android:layout_below="@id/b"
        android:layout_marginLeft="30dp"
        android:layout_marginTop="20dp"
        android:paddingTop="13dp"
        android:textStyle="bold"
        android:textSize="19dp"
        android:textColor="#935643"
        />

    <ImageView
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_marginLeft="150dp"
        android:layout_marginTop="20dp"
        android:src="@drawable/pay"
        />
</LinearLayout>